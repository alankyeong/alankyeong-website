---
import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';import '../styles/global.css';import {site} from '../data/site';
interface Props{title:string;description:string;image?:string;type?:'website'|'article';schema?:Record<string,unknown>|Record<string,unknown>[];canonical?:string}
const {title,description,image='/images/hero.jpg',type='website',schema,canonical}=Astro.props;const url=canonical||new URL(Astro.url.pathname,site.url).href;const absoluteImage=image?new URL(image,site.url).href:undefined;const ga=import.meta.env.PUBLIC_GA4_ID;
const isStaging=import.meta.env.PUBLIC_SITE_ENV==='staging';
const defaultSchema={"@context":"https://schema.org","@type":"WebSite",name:site.name,url:site.url,description:site.description};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}>{isStaging&&<meta name="robots" content="noindex,nofollow,noarchive"/>}<meta name="theme-color" content="#17324d"><link rel="canonical" href={url}><link rel="icon" href="/favicon.svg" type="image/svg+xml"><meta property="og:type" content={type}><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:url" content={url}>{absoluteImage&&<meta property="og:image" content={absoluteImage}/>}<meta name="twitter:card" content={absoluteImage?'summary_large_image':'summary'}><meta name="twitter:title" content={title}><meta name="twitter:description" content={description}>{absoluteImage&&<meta name="twitter:image" content={absoluteImage}/>}<title>{title}</title><script type="application/ld+json" set:html={JSON.stringify(schema||defaultSchema)} />{ga&&<script is:inline define:vars={{ga}}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',ga,{anonymize_ip:true});</script>}{ga&&<script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>}</head><body><a class="skip" href="#content">Skip to content</a><Header/><main id="content"><slot/></main><Footer/><script is:inline>document.addEventListener('click',e=>{const a=e.target.closest('a');if(!a||!window.gtag)return;let event;if(a.href.includes('ai.alankyeong.com'))event='ai_site_click';else if(a.href.includes('linkedin.com'))event='linkedin_click';else if(a.href.includes('stripe.com'))event='playbook_interest';if(event)window.gtag('event',event)});</script></body></html>

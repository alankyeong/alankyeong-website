---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { site } from '../data/site';

const { entry } = Astro.props as { entry: CollectionEntry<'insights'> };
const data = entry.data;
const description = data.description || data.excerpt || '';
const publishDate = data.publishDate || new Date(data.publish_at!);
const updatedDate = data.updatedDate || publishDate;
const image = data.image || data.featured_image;
const imageAlt = data.imageAlt || data.featured_image_alt || '';
const canonical = data.canonical || data.canonical_url;
const pageTitle = data.meta_title || `${data.title} | Alan Yeong`;
const metaDescription = data.meta_description || description;
const isDraft = data.draft || data.status === 'draft';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: metaDescription,
  image: image ? new URL(image, site.url).href : undefined,
  datePublished: publishDate.toISOString(),
  dateModified: updatedDate.toISOString(),
  author: { '@type': 'Person', name: data.author || 'Alan Yeong', url: site.url },
  publisher: { '@type': 'Person', name: 'Alan Yeong' },
  mainEntityOfPage: canonical || new URL(Astro.url.pathname, site.url).href,
};
---
<BaseLayout title={pageTitle} description={metaDescription} image={image} type="article" schema={schema} canonical={canonical}>
  <article class="article wrap narrow">
    <div class="article-labels"><p class="eyebrow">{data.category}</p>{isDraft && <span class="draft-badge">Preview draft</span>}</div>
    <h1>{data.title}</h1>
    <p class="lead">{description}</p>
    <p class="meta"><time datetime={publishDate.toISOString()}>{publishDate.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'})}</time> · By {data.author || 'Alan Yeong'}</p>
    {image && <img class="article-hero" src={image} alt={imageAlt} width="1536" height="1024" loading="eager" decoding="async">}
    <div class="prose"><slot/></div>
    <aside class="article-cta"><h2>Facing a decision across Asia?</h2><p>Bring the market question, evidence or assumption that needs a more experienced perspective.</p><a class="button" href="/contact/">Discuss a professional enquiry</a></aside>
  </article>
</BaseLayout>

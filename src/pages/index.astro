---
import BaseLayout from '../layouts/BaseLayout.astro';import ContactForm from '../components/ContactForm.astro';import {getCollection} from 'astro:content';import {site} from '../data/site';import {isPublishable,publicationTime} from '../utils/publication';
const staging=import.meta.env.PUBLIC_SITE_ENV==='staging';
const buildTime=import.meta.env.PUBLIC_BUILD_TIME?new Date(import.meta.env.PUBLIC_BUILD_TIME):new Date();
const insights=(await getCollection('insights',({data})=>staging||isPublishable(data,buildTime))).sort((a,b)=>publicationTime(b.data).valueOf()-publicationTime(a.data).valueOf()).slice(0,3);
const schema=[{"@context":"https://schema.org","@type":"Person",name:'Alan Yeong',url:site.url,jobTitle:'Asia Consumer Intelligence and Market Strategy Advisor',sameAs:site.linkedIn!='#'?[site.linkedIn]:[]},{"@context":"https://schema.org","@type":"WebSite",name:'Alan Yeong',url:site.url}];
---
<BaseLayout title="Alan Yeong | Asia Consumer Intelligence, Market Strategy & AI" description="Alan Yeong helps leaders understand Asian markets, consumers and growth opportunities through research, commercial and consulting experience." schema={schema}><section class="hero"><div class="wrap hero-grid"><div><p class="eyebrow">Consumer Intelligence · Market Strategy · Practical AI</p><h1>Understand Asia. Make better decisions. Turn insight into action.</h1><p class="lead">I help business leaders navigate markets, consumers and commercial opportunities across Asia—connecting evidence, local context and commercial priorities.</p><div class="actions"><a class="button" href="#expertise">Explore my expertise</a><a class="button secondary" href="/contact/">Discuss a professional enquiry</a></div></div><img class="hero-photo" src="/images/hero.jpg" alt="Alan Yeong reviewing market evidence in a contemporary office" width="1536" height="1024" fetchpriority="high"></div></section><div class="proof"><div class="wrap proof-grid"><div class="proof-item"><strong>25 years</strong>Cross-functional experience</div><div class="proof-item"><strong>Across Asia</strong>Regional perspective</div><div class="proof-item"><strong>Research to leadership</strong>Multidisciplinary thinking</div><div class="proof-item"><strong>Human insight + AI</strong>Decision support</div></div></div><section id="expertise"><div class="wrap"><div class="section-head"><p class="eyebrow">Where I help</p><h2>From market understanding to confident action</h2><p>Good decisions require more than data. They require context, interpretation and an understanding of how markets and people actually behave.</p></div><div class="cards"><article class="card"><h3>Asia market entry</h3><p>Examine opportunity, critical assumptions and the local realities that should shape a market decision.</p><a href="/advisory/">Explore market entry →</a></article><article class="card"><h3>Consumer intelligence</h3><p>Turn fragmented market and consumer evidence into a coherent strategic picture.</p><a href="/advisory/">Explore consumer intelligence →</a></article><article class="card"><h3>Research interpretation</h3><p>Move from technically sound findings to implications, direction and action.</p><a href="/advisory/">Explore research advisory →</a></article><article class="card"><h3>AI business playbooks</h3><p>Connect practical AI to real workflows, responsible judgement and repeatable practice.</p><a href="/ai-business-playbooks/">Explore AI playbooks →</a></article></div></div></section><section class="alternate"><div class="wrap split"><div><p class="eyebrow">Asia market expertise</p><h2>Asia is not one market</h2><p>Every market has its own cultural context, consumer behaviour, competitive structure and way of doing business. I help organisations understand what is genuinely transferable, what must be adapted and what needs to be learned locally.</p><a class="button" href="/asia-expertise/">Explore my Asia perspective</a></div><img class="section-photo" src="/images/asia-expertise.jpg" alt="Layered market evidence illustrating the diversity of Asian markets" width="1536" height="1024" loading="lazy"></div></section><section><div class="wrap"><div class="section-head"><p class="eyebrow">A multidisciplinary perspective</p><h2>A career shaped across several sides of the decision</h2></div><div class="journey"><span>Market Research</span><span>Consumer Intelligence</span><span>Banking</span><span>Marketing</span><span>Commercial Leadership</span><span>Consulting</span><span>AI-Enabled Advisory</span></div><p class="lead">This combination lets me see research not as an isolated activity, but as part of a wider path from evidence to commercial action.</p><a class="button secondary" href="/about/">Read my story</a></div></section><section class="alternate"><div class="wrap"><div class="section-head"><p class="eyebrow">Featured insights</p><h2>Ideas for leaders navigating Asia, consumers and AI</h2></div><div class="insight-grid">{insights.map(i=>{const slug=i.data.slug||i.id;const description=i.data.description||i.data.excerpt||'';return <article class="insight-card"><p class="eyebrow">{i.data.category}</p><a href={`/insights/${slug}/`}><h3>{i.data.title}</h3></a><p>{description}</p><a href={`/insights/${slug}/`}>Read insight →</a></article>})}</div><div class="actions"><a class="button secondary" href="/insights/">View all insights</a></div></div></section><section><div class="wrap split"><div><p class="eyebrow">Practical AI for business</p><h2>Make AI useful for the work that matters</h2><p>AI becomes valuable when it is connected to a defined business problem, the evidence required and responsible human judgement.</p><div class="actions"><a class="button" href="/ai-business-playbooks/">Explore AI Business Playbooks</a><a class="button secondary" href={site.aiUrl} target="_blank" rel="noopener">Visit dedicated AI website ↗</a></div></div><img class="section-photo" src="/images/ai-playbook.jpg" alt="Alan Yeong reviewing a practical AI-enabled business workflow" width="1536" height="1024" loading="lazy"></div></section><section class="cta-band"><div class="wrap split"><div><p class="eyebrow">Professional enquiry</p><h2>Let’s discuss the decision you are facing</h2><p>If you are evaluating an Asian market, interpreting research or exploring a practical use of AI, tell me a little about the situation.</p></div><ContactForm/></div></section></BaseLayout>
